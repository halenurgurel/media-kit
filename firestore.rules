rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /mediaKits/{mediaKitId} {
      allow read: if resource.data.isPublished == true
        || (request.auth != null && request.auth.uid == resource.data.userId);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // Instagram access tokens live here, not on the mediaKit doc itself, so a
      // published (publicly readable) media kit never exposes the token. Only
      // the server (Firebase Admin SDK, which bypasses these rules) reads/writes it.
      match /private/{document} {
        allow read, write: if false;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Username -> uid index used solely to check/reserve availability at signup.
    // A `get` (single doc by ID) is allowed for anyone so the register form can
    // check availability pre-auth; `list` stays closed so the collection can't be
    // enumerated. `create` is guarded by `!exists()` so two concurrent signups
    // for the same username can't both succeed (Firestore evaluates this
    // atomically against the write). Docs are otherwise immutable.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Daily AI bio-generation counters. Only the server (Firebase Admin SDK,
    // which bypasses these rules) writes here — clients may read their own
    // counter but never write it, so the rate limit can't be tampered with.
    match /aiUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
